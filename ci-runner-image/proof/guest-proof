#!/bin/bash
# The guest side of the proof of the image (ci-runner-image-proof). It is
# no file of the image. The proof adds it to the seed that the crate
# creche-ci-runner wrote, as the `runcmd` of a cloud-init `vendor-data`
# file. cloud-init then starts it as the transient unit `guest-proof`.
#
# Each result is one line `CI-PROOF <key>=<value>`. journald copies it to
# the serial console with the tag of the unit. The host reads the lines
# and judges them. The last line is
# `CI-PROOF done`, and then the guest powers off.
#
# `systemctl is-system-running --wait` waits for the end of the boot. The
# unit has the type `simple`, so its own start job does not hold the boot
# open.
set -uo pipefail

say() { printf 'CI-PROOF %s\n' "$*"; }

state=$(timeout 300 systemctl is-system-running --wait)
say "system=$state"
if [[ "$state" != running ]]; then
  systemctl --failed --no-legend --plain | while read -r line; do
    say "failed-unit=$line"
  done
fi

if runuser -u runner -- sudo -n true; then
  say "sudo=ok"
else
  say "sudo=refused"
fi

if hello=$(runuser -u runner -- docker run --rm hello-world 2>&1) &&
  grep -q '^Hello from Docker!' <<< "$hello"; then
  say "docker=ok"
else
  while read -r line; do
    say "docker-log=$line"
  done <<< "$hello"
  say "docker=failed"
fi

say "forgejo-runner=$(forgejo-runner --version 2>&1)"
say "node=$(runuser -u runner -- node --version 2>&1)"
say "git=$(runuser -u runner -- git --version 2>&1)"

# The storage of Docker and containerd and the job workspaces must sit on
# the data disk, not on the root.
data=$(stat -c %d /var/lib/ci-data)
storage="data-disk"
for path in /var/lib/docker /var/lib/containerd /var/lib/ci-data/work; do
  if [[ "$(stat -c %d "$path")" != "$data" || "$data" == "$(stat -c %d /)" ]]; then
    storage="root:$path"
  fi
done
say "storage=$storage"
say "data-disk=$(findmnt -n -o SOURCE,FSTYPE /var/lib/ci-data)"

# The network config of the seed: each global IPv4 address with the MAC
# of its NIC, and the default route. A line of `ip -o` starts with
# `<index>: <device> inet <address>/<prefix>`.
while read -r _ device _ address _; do
  say "address=$(cat "/sys/class/net/$device/address") $address"
done < <(ip -4 -o address show scope global)
say "gateway=$(ip -4 route show default | awk '{ print $3; exit }')"
say "instance-id=$(cloud-init query v1.instance_id 2>&1)"

# The runner config of the seed. The guest prints each field that is no
# secret. For the token it prints only whether it has the shape of a
# token, never the token.
runner=/etc/forgejo-runner/runner.json
if [[ -f "$runner" ]]; then
  say "runner-file=$(stat -c '%U:%G %a' "$runner")"
  python3 - "$runner" << 'EOF_PYTHON' | while read -r line; do say "$line"; done
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as file:
    runner = json.load(file)
print("runner-keys=" + ",".join(sorted(runner)))
for key in ("id", "uuid", "name", "address"):
    print(f"runner-{key}={runner.get(key)}")
print("runner-labels=" + ",".join(runner.get("labels") or []))
token = runner.get("token")
shape = isinstance(token, str) and re.fullmatch(r"[0-9A-Za-z]{40}", token)
print("runner-token=" + ("set" if shape else "bad"))
EOF_PYTHON
else
  say "runner-file=absent"
fi
job=/etc/forgejo-runner/job.env
if [[ -f "$job" ]]; then
  say "job-file=$(stat -c '%U:%G %a' "$job")"
  while read -r line; do
    say "job-env=$line"
  done < "$job"
else
  say "job-file=absent"
fi

# The proof masks the job unit on the kernel command line, so the fake
# registration runs no job (design section 8, PR 6 runs one). The two
# conditions of the unit must pass with the files of the seed. The verify
# reads the unit as systemd does.
say "job-unit=$(systemctl show -p LoadState --value forgejo-runner-job.service)"
if systemd-analyze condition \
  "ConditionPathExists=$runner" "ConditionPathExists=$job" > /dev/null 2>&1; then
  say "job-unit-conditions=pass"
else
  say "job-unit-conditions=fail"
fi
if verify=$(systemd-analyze verify forgejo-runner-job.service 2>&1) && [[ -z "$verify" ]]; then
  say "job-unit-verify=ok"
else
  while read -r line; do
    say "job-unit-verify-log=$line"
  done <<< "$verify"
  say "job-unit-verify=failed"
fi

say "done"
systemctl poweroff
