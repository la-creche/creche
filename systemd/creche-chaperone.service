# The PEP: the one SYSTEM unit in the stack. Installed by
# bootstrap-root.sh. Runs as its own user so no operator-context process can
# read its decrypted upstream credentials.
#
# Note on inbound filtering: systemd's IPAddressAllow/Deny BPF filters both
# directions, and the PEP needs world egress (MCP upstreams, delegation), so
# source filtering is traded away here — bearer tokens are the perimeter,
# matching LiteLLM's existing posture on the same host.
#
# THE FAMILY PATH (contract 04). PEP_REWORK_DIR below is required: a bearer is
# looked up against /srv/agents/state/rework/grants/<family>.json, and a PEP
# without it resolves no bearer at all.
#
# ORDER MATTERS, and getting it wrong takes the live PEP down. `create_app`
# builds the family gate at startup: FaultWriter mkdirs faults/pep/ and
# chmods it, FamilyAudit mkdirs audit/ and chmods it. A chmod of a directory
# chaperone does not OWN raises, and an unhandled raise there exits the process into
# Restart=on-failure. So the five directories must exist, with audit/ and
# faults/pep/ owned by chaperone, BEFORE this unit is installed and restarted.
# docs/rework/gate-1b.md §4 is the copy-pasteable order, and
# bin/rework-root-visit.sh is that order as one command. Every rework
# ReadWritePaths entry carries a leading "-", so a removed state root does not
# stop the unit.
#
# And it can arrive without a hand install. The release executor's `units`
# step refreshes every ALREADY installed unit file from this directory, and
# `sudo creche-deploy` restarts creche-chaperone. So a release carrying this
# file plus any later deploy is enough to restart the PEP on it. Create the
# directories before that pair, not after.
#
# grants/ needs NO directive. ProtectSystem=strict already serves the whole
# filesystem read-only, and the fence is DAC: 0750 <operator>:agents, with chaperone in
# the agents group. The rule a future editor keeps is the other half of that —
# never name /srv/agents/state/rework itself in ReadWritePaths. Name the two
# leaf directories the PEP actually writes, so chaperone can never write a grant
# file and widen itself.
#
# HOME/ReadWritePaths point at /var/lib/creche-chaperone/home, a chaperone-owned
# subdirectory, not the parent: the parent stays root:root 0755 so chaperone (and
# its MCP children) cannot rename/replace it out from under a deploy (write
# on the parent is rename/unlink access to the entry, not to its contents). The MCP servers live under /opt/mcp/<name>, root-owned and
# outside chaperone's home entirely.
[Unit]
Description=chaperone, the PEP (per-call authorization proxy)
After=network-online.target
Wants=network-online.target
# THE REWORK RESTART POLICY, argued in full in
# `systemd/creche-caregiver.service`. No start limit is the half that matters
# here: with `StartLimitIntervalSec=300` and `StartLimitBurst=5`, five
# deaths in five minutes would mean `failed`, for ever, over the ONE
# enforcement point. A PEP that
# cannot reach LiteLLM for six minutes must come back when LiteLLM does,
# not wait for a human who has not been told. `bin/rework-watchdog.sh`
# probes /healthz every minute and is what says the PEP is away.
StartLimitIntervalSec=0

[Service]
User=chaperone
Group=agents
# THE COMPONENT TREE, and not `/opt/creche/.venv`.
# Contract 06 §1 rule 8: a release must be able to change what runs.
# `chaperone/component.yaml` installs `/opt/components/chaperone`. A line naming the
# deployed venv would let a `chaperone` release build a tree, swap it, restart
# this unit, pass `chaperone-verify` out of the NEW tree and write `succeeded` —
# over a PEP still running the code `creche-deploy` put in /opt. The
# executor refuses that at step 8 with the code `unit`.
#
# THE TREE MUST EXIST BEFORE THIS FILE IS INSTALLED. Nothing but
# `bin/rework-release-visit.sh` builds the first one — a release replaces a
# tree, it does not make the first — and its step 4 builds
# /opt/components/chaperone before its step 5 installs this unit, in one run, for
# that reason. A unit that names an absent program is a PEP that will not
# start, and the PEP is the one enforcement point.
#
# EVERY OTHER PATH IN THIS FILE IS ABSOLUTE AND OUTSIDE THE TREE:
# PEP_UPSTREAMS stays in /opt/creche/chaperone/, SOPS_AGE_KEY_FILE in
# /etc/agent-pep/, HOME in /var/lib/creche-chaperone/home, and every state path
# under /srv/agents. A RELATIVE path anywhere here would resolve against a
# different tree. PEP_SECRETS, the sops file, is the site's: this file names
# no path for it, and the site file below sets it.
# `chaperone-verify`, the manifest's verify
# hook, is a console script of the same package and comes from the same
# tree at /opt/components/chaperone/bin/chaperone-verify.
#
# The tree is root's, and this unit is `User=chaperone`: the visit runs the
# executor's own `normalize_modes` over it, so chaperone can read the tree and
# execute the two console scripts and can write nothing.
ExecStart=/opt/components/chaperone/bin/chaperone
# `always`, not `on-failure`. systemd calls SIGHUP, SIGINT, SIGTERM and SIGPIPE
# CLEAN exits, so `on-failure` leaves the PEP down after any of them: a
# SIGHUP that arrives before the process installs its handler ends it, and
# no tool call works. Nothing that ends the one enforcement point is a
# reason for it to stay down. `systemctl stop` still stops it.
#
# The back-off is what makes restarting for ever affordable.
# `RestartSteps=`/`RestartMaxDelaySec=` are systemd v254 and this host runs
# 255: the delay grows from RestartSec to RestartMaxDelaySec over
# RestartSteps steps. The floor is 5 s, so every rework unit shares one
# policy.
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=120s

# The site's values: AGENT_LAN_ADDRESS (the bind, and TEI on the same
# address), AGENT_HA_URL when the site has a Home Assistant, and PEP_SECRETS.
EnvironmentFile=/etc/creche/site.env
Environment=PEP_AUDIT_DIR=/srv/agents/state/pep/audit
Environment=PEP_UPSTREAMS=/opt/creche/chaperone/upstreams.yaml
# Installed by bin/rework-release-visit.sh.
#
# PEP_RELEASE_REQUESTS_DIR turns the `release` verb from a named seam into a
# door. Without it contract 04 §4.1's `release` answers 501, which is the
# fail-closed end. The directory is <operator>:agents 2770 and root still refuses
# a request owned by any uid but the operator's or chaperone's. Its parents are root's
# all the way up.
Environment=PEP_RELEASE_REQUESTS_DIR=/var/lib/creche-handover/releases/requests
# PEP_UPSTREAMS_GENERATED is the roster ROOT writes at the end of a verified
# mcp-servers release (executor/roster.py). It is outside every
# component install tree on purpose: a `chaperone` release swaps the whole `chaperone`
# tree, so a roster inside it would vanish with nothing to say why. Without
# this line a released MCP server is installed and never served.
Environment=PEP_UPSTREAMS_GENERATED=/var/lib/creche-handover/upstreams.yaml
Environment=SOPS_AGE_KEY_FILE=/etc/agent-pep/age.key
# The PEP's own writable HOME. Pep-owned subdirectory, not the
# /var/lib/creche-chaperone parent — see the header comment.
Environment=HOME=/var/lib/creche-chaperone/home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# The family path's state root (contract 04 §1.1, §1.6, §6). grants/ is read,
# audit/ and faults/pep/ are written. Required: see the header comment.
Environment=PEP_REWORK_DIR=/srv/agents/state/rework
# ---- two doors and the phone rail, all INERT until their files exist ----
# These four exist so the operator makes ONE root visit. Each is proved inert below,
# from the code, not from hope. `bin/tests/test_rework_root_visit.py` holds
# this unit to every claim in this block.
#
# THE DELEGATE DOOR (contract 04 §7.3). The socket is attendance's,
# and the token file is attendance's too. Both may be absent when this process
# starts, and that is the normal case: attendance is a USER unit and starts
# later.
#   - socket absent: HttpDelegateDoor builds its transport lazily and
#     connects at call time, so an absent socket is an httpx.ConnectError on
#     the call and nothing at startup (delegate.py `_open`, `_post`).
#   - token file absent: __main__ `_delegate_token_file` only PROBES it, logs
#     a warning and returns the path. The door re-reads the file on each call
#     (CachedTokenFile) and fails that call closed. This is why no rotation
#     needs `systemctl restart creche-chaperone`.
# With both lines removed, `build_delegate_door` returns None, invoke_agent
# stays a seam answering not_implemented, and the manifest never offers it.
Environment=PEP_SESSIOND_SOCKET=/srv/agents/state/rework/sock/sessiond.sock
Environment=PEP_DELEGATE_TOKEN_FILE=/srv/agents/state/rework/tokens/door-delegate.token
# THE DISPATCH DOOR (contract 02 §13.4): `enqueue` and `job_status`
# on the family path, over the same socket, under a bearer of their own so a
# stolen token stays inside one family kind. Inert the same way: __main__
# `_door_token_file` only PROBES the file and logs a warning, the door
# re-reads it on each call and fails that call closed. With the line removed
# both verbs stay seams answering not_implemented.
Environment=PEP_DISPATCH_TOKEN_FILE=/srv/agents/state/rework/tokens/door-dispatch.token
# THE PHONE RAIL (contract 04 §8.4). This is the PROTECTED Node-RED
# instance, loopback only by design (docs/node-red-mcp.md §1: never the LAN
# IP). The URL is configuration and belongs here; the two bearers it needs
# are secrets and ride the PEP_SECRETS file instead, because this file is in
# git.
#
# `build_gatekeeper` needs approval_hook_url AND approval_hook_token AND
# approval_callback_token. With any one missing no gatekeeper is built and a
# gated family action stays a seam. The PEP_SECRETS file holds both tokens
# (sops leaves key names in plaintext, so this is readable without
# decrypting anything).
#
# A family gate's tap reaches the PEP only through the rework legs
# (docs/rework/nodered/README.md). The live tab parses
# AGENT_APPROVE_<job>_<gate> and requires a 26 character ULID in the middle
# field, so without the legs a FAMILY gate's tap is dropped before it reaches
# anything, and §8.5 turns a dropped tap into a 15 minute stall per gated
# call.
Environment=PEP_APPROVAL_URL=http://127.0.0.1:1881/hook/approval

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
# THE TWO CAPABILITIES. Each MCP server runs as its own
# mcp-<name> user (contract 01b §9). The PEP starts every one through
# chaperone-as, which switches the child to that user before it execs the
# server, and that switch is all these two are for: CAP_SETGID for
# setgroups and setresgid, CAP_SETUID for setresuid. Nothing else in the
# PEP calls either. Ambient, because this unit runs as chaperone, not root: an
# ambient capability survives the exec of an unprivileged binary, and
# NoNewPrivileges=yes still holds, since it refuses privilege GAINED at an
# exec and this is privilege kept. The launcher empties all four sets and
# sets no_new_privs before the server's exec, then reads /proc/self/status
# back, so no server holds either. The syscall filter above already
# allows the switch (@setuid is inside @system-service).
#
# The cost, stated once: this process can take any uid, root's included,
# and every child holds the two until it drops them (the launcher at once,
# `sops -d` for its whole run). And a release that restores the previous
# `chaperone` tree keeps THIS file (executor step 10 puts back trees, not
# units), and that tree starts servers directly, with both capabilities.
# Put the previous unit back by hand in that case.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
PrivateDevices=yes
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RemoveIPC=yes
SystemCallArchitectures=native
UMask=0027
# MemoryDenyWriteExecute is deliberately OFF: the PEP and its MCP children
# are plain Python/uv — no JIT — so it should be safe, but ctypes-based
# upstreams (or a future uvx package) can need a writable+executable page.
# Verify with it on before flipping.
# MemoryDenyWriteExecute=yes
# Everything chaperone never needs to see, even read-only through ProtectSystem's
# view of /: leading "-" skips the entry if the path is absent so a fresh
# host's missing state.db doesn't fail the unit. state.db is the retired
# materializer's and may outlive it on a host. The PEP holds CAP_SETUID, so the
# file's 0600 mode does not fence it: this entry does.
InaccessiblePaths=-/srv/agents/vault -/srv/agents/registry -/srv/agents/work -/srv/agents/state/materializer/state.db
# Three rework entries are the family path's, and they are the only three:
# the audit record v2 (contract 04 §6), the grants_stale fault file caregiver
# reads (§1.6), and attendance's socket directory (contract 02 §3 rule 1),
# because connect(2) on a Unix socket asks for write. The fourth,
# releases/requests, is the `release` verb's spool (see its Environment=
# line above).
#
# EVERY rework entry carries a leading "-". Without it, systemd refuses to
# START the unit when the path is absent, and each one is absent on a host
# that has not had the root visit. That is the difference between a PEP that
# ignores the family path and a PEP that will not boot.
#
# sock/ is safe to grant: it is 2750 <operator>:agents, so group `agents` gets r-x
# and chaperone has no DAC write on the directory whatever this line says. chaperone can
# connect to the 0660 socket inside it and cannot unlink or replace it. Never
# name /srv/agents/state/rework itself here — see the header comment.
#
# The last entry is contract 01b §4.2's state root. A release
# makes /var/lib/agent-mcp/<name>, mcp-<name> 0700, for each MCP server that
# declares run.state_dir. The servers are this unit's children and share its
# mount namespace, so without the entry each state directory is read-only to
# its own server. The root is root:root 0755: neither chaperone nor a server can
# add, rename or replace an entry in it. It must EXIST when this unit starts,
# or the "-" skips it until the next restart, so bin/rework-release-visit.sh
# makes it before it restarts the PEP.
ReadWritePaths=/srv/agents/state/pep/audit /var/lib/creche-chaperone/home -/srv/agents/state/rework/audit -/srv/agents/state/rework/faults/pep -/srv/agents/state/rework/sock -/var/lib/creche-handover/releases/requests -/var/lib/agent-mcp

[Install]
WantedBy=multi-user.target
