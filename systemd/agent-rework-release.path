# Starts agent-rework-release.service whenever the REWORK release spool holds
# a request (docs/rework/stage7-releases.md §2.2). SYSTEM unit, root.
#
# It is the release executor's trigger.
#
# PathExistsGlob re-checks when the service exits and re-fires while a match
# remains. The executor therefore ALWAYS drains requests/ — what it will not
# parse is renamed into rejected/ — or this unit loops into systemd's start
# limit. Writers rename a finished file into place (`.<ULID>.tmp` ->
# `<ULID>.json`): a name that does not end in .json neither matches here nor
# is touched by the executor.
#
# Installed and enabled by hand, never by a release: contract 06 §1.1, "the
# thing that deploys code is not deployed by code". Harmless before the spool
# exists — a glob under a missing directory matches nothing.
#
# The spool sits under root's own root, /var/lib/agent-release, every
# ancestor root's (release/src/agent_release/executor/layout.py).
[Unit]
Description=Watch the rework release spool for requests

[Path]
PathExistsGlob=/var/lib/agent-release/releases/requests/*.json

[Install]
WantedBy=multi-user.target
