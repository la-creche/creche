# One firing of one autonomous family's cron trigger (rework contract 01
# §3.13, contract 05). USER unit, as the operator. Templated: `%i` is the family name,
# so `agent-trigger@ops.service` fires the `ops` family.
#
# Installed once by the rework bootstrap script. The per-family .timer units
# beside it are GENERATED by agent-managerd from `triggers:` in family.yaml
# and carry a "do not hand-edit" header — this file is the one half a human
# owns. Each generated timer points here with `Unit=agent-trigger@<family>
# .service`; without that line systemd would look for a service named after
# the timer, which does not exist.
#
# `agent-trigger` is the rework trigger CLI. It creates one session per
# firing and hands it to sessiond (contract 02). It holds no credential of
# its own. For a family whose file carries `quiet:`, it reads that family's
# PEP token from creds.json (0600) for the family's own two reads, before
# deciding to fire at all (contract 01 §3.15).
[Unit]
Description=Fire the %i family's cron trigger
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/agent-control
# sbx panics without both (systemd/AGENTS.md): its state is per-user and a
# user manager sets neither. Anything downstream that shells out to sbx
# inherits the requirement.
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
# The site's AGENT_LAN_ADDRESS: where the quiet check reaches the PEP.
EnvironmentFile=/etc/agent-control/site.env
# The same component venv `agent-trigger-webhooks.service` runs from: the
# trigger door ships inside `sessiond` (contract 06 §1 rule 1).
ExecStart=%h/.local/components/sessiond/bin/agent-trigger fire %i

# A user unit on this host cannot use mount-namespace options
# (apparmor_restrict_unprivileged_userns=1), but seccomp, prctl and rlimit
# options need no namespace and apply fine (systemd/AGENTS.md).
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictRealtime=yes
LockPersonality=yes
UMask=0077
# A firing that cannot finish must not hold the next one off forever. The
# CLI only enqueues; the turn itself runs under sessiond's own limits.
TimeoutStartSec=120
