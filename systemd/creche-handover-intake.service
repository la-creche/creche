# The secret intake (docs/rework/stage7-releases.md §4.3). SYSTEM unit, root.
#
# It watches /srv/agents/state/rework/secret-gaps/ for gaps caregiver opened,
# mints one single-use fifteen-minute token per gap, pushes the operator one
# link for each, and serves the one-field form over https on port 8380 of
# the host's LAN address while a token is alive. A pasted value goes to
# sops's stdin and lands sealed at
# /var/lib/creche-handover/secrets/<name>.enc, root:root 0600, under root's own
# root.
#
# The port is bound only while a token is pending. A host with no open gap
# has no root listener on the LAN at all, which is the smallest surface this
# can have and still be reachable when the operator needs it.
#
# Installed and enabled BY HAND, never by a release: contract 06 §1.1 keeps
# the thing that holds secrets outside every release, exactly as it keeps the
# executor's path unit and root wrapper outside one (§6 row 16). Concretely,
# this file reaches the host only when the operator re-runs
# `sudo bin/rework-release-visit.sh`, a root visit, which copies it (and
# `bin/creche-handover-intake`) from `/opt/creche` into
# `/etc/systemd/system` and reloads it. A change here is inert until then.
#
# FOUR PATHS THIS UNIT NEEDS, all root:root, all made by hand:
#   /etc/agent-intake/intake.crt  0600  self-signed, subjectAltName IP:<host LAN address>
#   /etc/agent-intake/intake.key  0600  its private half
#   /etc/agent-intake/sops.yaml   0600  root's own copy of the recipient set
#   /root/.config/sops            0700  root's age key, which the wrapper
#                                       decrypts secrets.enc.env with. The
#                                       sandbox below hides /root and binds
#                                       this one directory back in.
# The service refuses to serve unless the certificate and the key are
# root-owned regular files closed to group and other: a key the operator's account can write
# is a certificate that account chose, and root would then hand the operator's browser a
# certificate an attacker holds the private half of.
[Unit]
Description=Accept one pasted secret for one open gap, over TLS on the LAN
After=network-online.target
Wants=network-online.target
# The rework restart policy, argued in full in creche-caregiver.service's
# [Unit] comment: restart for ever, no start limit, back off in [Service]
# instead. This directive belongs in [Unit], not [Service]: a MISPLACED copy
# of this exact line makes this systemd version log "Unknown key name
# 'StartLimitIntervalSec' in section 'Service', ignoring" and fall back to
# systemd's own default limit, which a crash loop then hits.
StartLimitIntervalSec=0

[Service]
Type=simple
# The wrapper decrypts RELEASE_APPROVAL_URL and RELEASE_APPROVAL_TOKEN with
# root's age key and execs the intake, which keeps those two and clears the
# rest of the environment before it accepts a connection. No EnvironmentFile:
# the bearer is in no env file, no argv and no URL (invariant 13).
ExecStart=/usr/local/sbin/creche-handover-intake
# A listener that died with a gap open leaves the operator unable to answer it.
# The back-off is the shared rework policy: five seconds first, growing to
# two minutes over five steps (creche-caregiver.service's [Unit] comment).
# The wrapper's own permanent refusal — root does not own the binary — is
# exactly why the policy removes the start limit rather than sizing it: a
# unit that gives up over a fault only the operator can fix is a unit that goes
# quiet with a gap still open.
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=120s
# A system unit gets no HOME, and sops wants one.
Environment=HOME=/root
# 0077: every file this service creates holds or describes a secret. The
# store fchmods 0600 itself; this covers anything else.
UMask=0077
# sops walks UP from the working directory looking for a .sops.yaml, and one
# with no matching rule makes it refuse to encrypt at all
# (handover/tests/test_handover_r7g_sealer_sops.py). seal_argv passes
# --config /dev/null so no such file can decide anything, and this is the
# second half of the same belt: the directory root sits in is root's own.
WorkingDirectory=/etc/agent-intake

# The whole job: read one operator-written directory, write one root-owned
# directory, start one sops child, bind one port, reach one Node-RED hook.
# Everything else is closed.
ProtectSystem=strict
ReadWritePaths=/var/lib/creche-handover/secrets /srv/agents/state/rework/secret-gaps
# tmpfs and not yes. ProtectHome=yes makes /home, /root and /run/user
# inaccessible and empty, and the wrapper decrypts secrets.enc.env with
# SOPS_AGE_KEY_FILE=/root/.config/sops/age/keys.txt. The wrapper then exits
# 1 by design, and the rework restart policy (this file's [Unit] comment)
# restarts it for ever rather than letting it go quiet: with no bind-back
# that is an unbounded loop that never once decrypts, saying only "cannot
# decrypt" every few minutes for as long as nobody
# looks. So /root is an empty read-only tmpfs and the one directory root
# actually needs is bound back in, read only. The operator's home stays hidden,
# which is what this directive is for.
ProtectHome=tmpfs
BindReadOnlyPaths=/root/.config/sops
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectClock=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectControlGroups=yes
# One IPv4 listener and one outbound HTTPS call. AF_UNIX stays for the name
# resolution that call needs.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Root here is a uid, not a set of capabilities. Two are load-bearing:
# the gap files are <operator>:<operator> 0640 in an operator-owned directory, so reading
# them needs DAC_READ_SEARCH and unlinking a filled one needs DAC_OVERRIDE.
# If the journal ever says the gap directory cannot be read, this line is
# the first thing to widen.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
AmbientCapabilities=

# Deliberately NOT set, each with its reason:
#   PrivateDevices       — the sealer hands the plaintext to sops on
#                          /dev/stdin, and a private /dev is a change to that
#                          one path that no test off the host can exercise.
#                          Measure one paste with it, then set it.
#   SystemCallFilter     — plausible as @system-service, untested against
#                          sops. The executor's unit says the same thing for
#                          the same reason: measure before setting it.
#   MemoryDenyWriteExecute — untested against the Go runtime sops ships.
#   ProcSubset=pid       — /dev/stdin resolves through /proc/self/fd, and
#                          this is the wrong week to narrow /proc.

[Install]
WantedBy=multi-user.target
