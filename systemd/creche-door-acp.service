# The ACP front door (Phase 2 plan, rows 26 and 27). USER unit, as the operator.
#
# `agent-door-acp` binds the host's LAN address, port 8390, behind NPM and
# Authentik forward auth. It takes `WS /acp/<family>` and forwards ACP frames
# to attendance's `WS /acp/{family}` on attendance's Unix socket. It
# translates nothing.
#
# The door ships in `attendance`'s tree, as each other door does
# (`attendance/component.yaml`). A release of `attendance` restarts this unit
# with its own, when the host has it installed. No script installs it yet.
[Unit]
Description=agent-door-acp, the ACP front door
After=network-online.target creche-attendance.service
Wants=network-online.target
PartOf=creche-attendance.service
# THE REWORK RESTART POLICY, argued in full in
# `systemd/creche-caregiver.service`: no start limit, and a back-off.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/creche
# Every user unit carries both lines (systemd/AGENTS.md).
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
# The site's AGENT_LAN_ADDRESS: the bind when nothing sets DOOR_ACP_BIND.
EnvironmentFile=/etc/creche/site.env
# Two secrets. The unit names each path, never a key. Each file is mode 0600.
# The client bearer: NPM sends it for a browser, a terminal client sends it.
Environment=DOOR_ACP_ACCESS_KEY_FILE=/srv/agents/state/creche/door-acp.key
# attendance's door-acp token: the door sends it on attendance's socket.
Environment=DOOR_ACP_BEARER_FILE=/srv/agents/state/creche/tokens/door-acp.token
# DOOR_ACP_SOCKET_FILE defaults to attendance's socket on the state root.
# DOOR_ACP_REQUIRE_AUTHENTIK defaults to false: the bearer is the only check.
# The chat-UI deployment, where the browser reaches the door through NPM and
# Authentik, sets it to true in a drop-in. A client without the Authentik
# header then gets 401:
#   ~/.config/systemd/user/creche-door-acp.service.d/authentik.conf
#   [Service]
#   Environment=DOOR_ACP_REQUIRE_AUTHENTIK=true
# The site file holds the catalog keys only, so the flag is not set there.
# A terminal deployment sets nothing.
# A bad key file or a wide bind stops the unit here, before a bind.
ExecStartPre=%h/.local/components/attendance/bin/agent-door-acp --check
ExecStart=%h/.local/components/attendance/bin/agent-door-acp
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=120s
KillSignal=SIGTERM
TimeoutStopSec=30

# The hardening that needs no mount namespace (systemd/AGENTS.md).
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictRealtime=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=default.target
