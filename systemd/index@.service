# Vault index build for scope %i. USER unit; %i = scope name
# under /srv/agents/vault. The sandbox index-%i must exist (provision-indexer.sh).
[Unit]
Description=Vault index build for scope %i

[Service]
Type=oneshot
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
# sbx phones home on every invocation and that, not the indexing, is
# seconds of each run. This unit execs sbx itself, so it opts out here.
Environment=SBX_NO_TELEMETRY=1
NoNewPrivileges=yes
UMask=0077
# `sleep 8` is load-bearing: sbx exec's attach races process exit for short
# commands; an unchanged scope indexes in <1s, so the tail keeps
# the command long-lived and the client reliable.
ExecStart=/usr/bin/timeout --signal=KILL 1500 sbx exec index-%i -- \
  sh -c 'index-scope /srv/agents/vault/%i /srv/agents/state/index/%i; rc=$?; sleep 8; exit $rc'
TimeoutStartSec=1560
