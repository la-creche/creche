# creche-vmm: the one process that owns every Cloud Hypervisor VM of the
# playpen (decisions CH9, CH7-5). USER unit, as the operator (fact 57): the
# operator is in group `kvm`, the user manager delegates its cgroups, and
# linger is on, so the vmm needs no sudo.
#
# The name is `creche-vmm.service` (decision CH36 G17). It replaces the name
# `vmm.service` in CH20. A client of `vmm.sock` (caregiver, attendance)
# orders itself with `After=creche-vmm.service` at most, never `Requires=`
# or `BindsTo=` (CH19 (4), CH20). A restart of the vmm drops every client
# link, and each client treats that as transient.
#
# Installed by: `bin/fleet-up up`, which the operator runs. It installs
# the unit when the vmm tree is there, and it starts the unit when the
# image root holds `digests.json`. No agent installs it.
[Unit]
Description=creche-vmm, the owner of every Cloud Hypervisor VM
# THE REWORK RESTART POLICY, argued in full in
# `systemd/creche-caregiver.service`: no start limit, and a back-off.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
# Decision CH59 rule 1: the vmm compiles in no default
# (rust/crates/vmm/AGENTS.md, "The config"), and the site file holds only
# the overrides of the catalog (env/AGENTS.md, "The files" rule 4). So the
# unit reads `vmm.env` first. It holds each key of
# `rust/crates/vmm/src/config.rs` except RUNTIME_DIRECTORY, as `creche-env
# get` resolves it against the site file: paths and sizes, no secret.
# `bin/fleet-up up` writes it with `creche_env_get`, as it writes
# `noticeboard.env`. Without the file the start fails before the vmm runs.
# Without a key the vmm exits 78 and names the key.
EnvironmentFile=/srv/agents/state/creche/vmm.env
# The site values. The site file comes last, so a value that it sets wins
# over a stale copy in vmm.env.
EnvironmentFile=/etc/creche/site.env
# The run root: `%t/vmm`, which is /run/user/<uid>/vmm. It holds `vmm.sock`
# and the VM run dirs. Mode 0700 is the only guard of `vmm.sock`, because
# every client runs as the operator (CH20). systemd sets RUNTIME_DIRECTORY
# to it, and `config.rs` reads that key (gap G5 option A). One entry only:
# systemd joins more than one with `:`, and the config refuses a `:`.
# RuntimeDirectoryPreserve keeps its default, `no`: systemd removes the dir
# at each stop and each restart, a crash included. The bind refuses a path
# that exists (rust/crates/vmm/src/server/accept.rs), and the vmm then exits
# 78, so the dir must be fresh at each start. Each VM's `serial.log` is in
# the run root until plan PR D17 moves it to `sessions/<id>/` in the state
# root (decision CH59 rule 2). Until then each stop also removes it.
RuntimeDirectory=vmm
RuntimeDirectoryMode=0700
# The state root: `%S/creche-vmm`, which is ~/.local/state/creche-vmm, the
# default of VMM_STATE_ROOT (decision CH50 rule 11). It holds the rows, the
# session disks, the snapshots and the digest store (decision CH39 rule 3).
# The session disks hold guest data, so the operator alone reads it.
StateDirectory=creche-vmm
StateDirectoryMode=0700
# The binary row installs the vmm tree under /opt/components (CH7-5). The
# AppArmor slot profiles name the same tree.
ExecStart=/opt/components/vmm/bin/vmm serve
# No core dumps (decision CH8-5, gap G27 option A). The launch step also
# sets RLIMIT_CORE to 0 for each CH, because a scope cannot set an rlimit.
LimitCORE=0
# The rework restart policy, argued in [Unit] above.
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=120s
# Exit 78: a missing or bad key, or a failed start step (owner item 86).
# A restart changes nothing until the operator fixes the cause
# (bin/systemd-proof.sh, the restart rule).
RestartPreventExitStatus=78
# The start. The vmm sends no readiness notice, so under Type=simple the
# start job ends at the fork, and no start timeout reaches `vmm serve`.
# The first start after a release imports each entry of `digests.json`
# before the bind of `vmm.sock`: it runs `zstd -d` on each root disk and
# hashes it (decision CH58 rule 5). No one measured that time on the host.
# So the bound is `infinity`: a later readiness notice or ExecStartPre then
# cannot cut that first start short (rust/crates/vmm/AGENTS.md, caller duty
# 9). A later start finds each digest in the store and reads no byte.
TimeoutStartSec=infinity
# The stop. At SIGTERM the vmm closes the door links, snapshots each VM that
# may sleep and stops the rest (gap G16 option A). One deadline bounds every
# step: SHUTDOWN_WAIT, 85 s (decision CH56 rule 2). The vmm keeps 5 s for its
# exit (CH56 rule 3), so 90 s here. Past it systemd sends SIGKILL, and each
# CH ends with the vmm through PDEATHSIG (CH19 (4)). Change this value and
# UNIT_STOP_TIMEOUT of rust/crates/vmm/src/shutdown.rs together.
# bin/tests/test_vmm_unit.py fails when they differ, and it pins each
# decided line of this unit.
KillSignal=SIGTERM
# SIGTERM goes to the vmm alone. The default, control-group, sends it to
# each process of the cgroup at once. An idle retire may already run at
# SIGTERM (decision CH56 rule 2), and its ch-remote, fallocate, zstd or
# mke2fs child would die behind the back of the vmm. The vmm finishes or
# stops its own children inside SHUTDOWN_WAIT (gap G16). The SIGKILL at
# TimeoutStopSec still reaches each process left in the cgroup. Each CH
# sits in its own creche-vm-* scope, outside this cgroup.
KillMode=mixed
TimeoutStopSec=90

# A user unit on this host cannot use mount-namespace options
# (apparmor_restrict_unprivileged_userns=1), but seccomp, prctl and rlimit
# options need no namespace (systemd/AGENTS.md). The launch stage sets
# no_new_privs itself before the exec of CH (decision CH55), and the kvm
# job proves the slot label after it. Under this line no_new_privs is set
# earlier, at the write of the exec attribute too. The rework of #443
# proves that order in the kvm job (systemd/AGENTS.md, Caller duties).
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictRealtime=yes
LockPersonality=yes
# 0077: every file of the vmm is the operator's alone. Each dir that the
# vmm makes has its own mode too.
UMask=0077

[Install]
WantedBy=default.target
