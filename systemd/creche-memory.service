# creche-memory: the memory service of the vault. USER unit, as the operator.
#
# It hosts the memory store, syncs the vault into it, answers searches, and
# applies every vault write that an agent asks for (memory/AGENTS.md). Agents
# reach it only through the `memory` upstream of the chaperone, which runs as
# its own user and connects to the socket below. The server answers that
# user's uid and no other.
#
# It runs as the operator, the owner of the vault, so every file it writes
# stays the operator's. Writes reach each Obsidian device within seconds.
#
# Installed by: no script yet. The release of the component that ships the
# memory tree installs it.
[Unit]
Description=creche-memory, the memory service of the vault
After=network-online.target
Wants=network-online.target
# THE REWORK RESTART POLICY, argued in full in
# `systemd/creche-caregiver.service`: no start limit, and a back-off.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
# MEMORY_LITELLM_KEY: the `memory` key of LiteLLM. The file is the
# operator's, mode 0600. The key never rides on argv or in a log line.
EnvironmentFile=/srv/agents/state/creche/memory.env
# The site's AGENT_LAN_ADDRESS, which the LiteLLM and TEI addresses default to.
EnvironmentFile=/etc/creche/site.env
# The tree of the component, not the shared workspace venv
# (systemd/AGENTS.md).
ExecStart=%h/.local/components/memory/bin/creche-memory
# A deploy runs this before it swaps the unit. It opens no socket.
ExecStartPre=%h/.local/components/memory/bin/creche-memory --check
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=120s
# Exit 78: the config or the host stops the start. Restarting changes
# nothing until the operator fixes it (bin/systemd-proof.sh, the rule).
RestartPreventExitStatus=78
# THE STOP (memory/AGENTS.md, the stop). SIGTERM goes to the main process
# only. It cancels the tasks of the store loop, waits at most 10 s for them,
# then exits at once, and the exit ends Cognee's workers. So no worker of
# Cognee starts again during the stop. The stop writes nothing to the graph
# database: ladybug 0.22.3 opens a file whose worker died in a checkpoint,
# with every committed row.
KillMode=mixed
TimeoutStopSec=30
# THE MEMORY. The kernel OOM killer picks the largest process of the unit,
# and that is the graph worker. A kill ends the sync that runs, so the unit
# must never live at its hard limit. Cognee's buffer pool of the graph
# database is 32 GiB by default. The service sets it to 2 GiB
# (memory/src/creche_memory/store.py).
#
# Measured on the host on 2026-11-15 at 01:05 UTC, 3 h and 3 syncs after a
# start, with the first limit MemoryMax=2G:
#
# | Process          | RAM      | Swap     |
# |------------------|----------|----------|
# | main             | 0.24 GiB | 0.49 GiB |
# | graph worker     | 1.15 GiB | 1.15 GiB |
# | vector worker    | 0.70 GiB | 0.40 GiB |
# | resource tracker | 0.01 GiB | 0.01 GiB |
#
# The unit sat at 2.0 GiB of 2.0 GiB, with 2.2 GiB in swap. `memory.events`
# counted 12,567 `max` events and 0 `oom_kill`. The graph file is 262 MiB.
# Of the graph worker's 2.3 GiB, only 0.17 GiB is in ladybug's buffer pool.
# The rest is anonymous heap. Swap peaks of earlier runs, each with a memory
# peak at the 2.0 GiB limit: 4.6 GiB, 4.9 GiB (18 h, 7 syncs, 2026-11-14),
# and 6.8 GiB (the failing sync loop of 2026-11-09). The host has 128 GiB of
# RAM and 8 GiB of swap for everything.
#
# So the footprint is 4.2 to 8.8 GiB, and it grows over a run.
# MemoryHigh=8G is the warning: above it the kernel throttles and reclaims,
# and kills nothing. Each crossing adds to `high` in the cgroup's
# `memory.events`, and the syncs get slower. MemoryMax=12G is the kill. The
# 4 GiB between them is the time to see the warning and stop the unit with a
# SIGTERM. No watcher reads `high` yet (memory/AGENTS.md, known gaps).
# MemorySwapMax=2G keeps the unit from filling the host's swap: a runaway
# then ends in this unit's own OOM, not a host-wide one.
MemoryHigh=8G
MemoryMax=12G
MemorySwapMax=2G

# A user unit on this host cannot use mount-namespace options
# (apparmor_restrict_unprivileged_userns=1), but seccomp, prctl and rlimit
# options need no namespace (systemd/AGENTS.md).
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictRealtime=yes
LockPersonality=yes
# 0077: the store is the operator's alone. Each vault file gets mode 0644
# and the socket gets 0660 from the service itself.
UMask=0077

[Install]
WantedBy=default.target
