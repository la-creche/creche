# The family manager (rework contract 05). USER unit, as the operator.
#
# It watches the rework registry and converges every family to its
# family.toml: the LiteLLM key, the PEP token, the table of
# the family in /etc/chaperone/policy.toml, the family config directory,
# egress.json, repos.json and the trigger timers. It starts no VM: the vmm
# starts one VM per session (decision CH1). Invariant 9 is the whole
# point — "a permission change needs one action and no manual apply" — so
# this runs as a daemon, not as a command anybody types.
#
# Installed by `bin/rework-cutover.sh up`.
#
# Reload means "look now": SIGHUP ends the poll wait early, so an edit that
# cannot wait two seconds does not have to.
[Unit]
Description=caregiver, the rework family manager
# Decision CH20: a client of vmm.sock orders after the vmm at most. No
# Requires= and no BindsTo=: a vmm restart drops each connection, and the
# delete of a family tries its drop again at the next look.
After=network-online.target creche-vmm.service
Wants=network-online.target
# THE REWORK RESTART POLICY. Decided once, argued here, and named by the
# other four always-on rework units (`creche-attendance`,
# `creche-noticeboard`, `creche-door-trigger`, `creche-chaperone`). Change it here and
# in all five, or `bin/tests/test_rework_unit_restart.py` fails.
#
# WHY NO START LIMIT. With StartLimitIntervalSec=120 and StartLimitBurst=5,
# five crashes in 25 seconds and systemd gives up. A root script that leaves
# /srv/agents/state/creche/releases/ root:root 0750 is enough: caregiver runs
# as the operator, a PermissionError leaves the reconcile loop, five crashes, then
# `failed`. Fixing the mode twenty minutes later starts nothing, so caregiver
# stays dead until somebody notices, and every status document still says
# `in_sync`, because a dead writer changes nothing.
#
# A start limit answers "is this service healthy?" with "stop trying". For
# a service nothing else watches that is the worst available answer: it
# turns a transient fault — a wrong mode for twenty minutes, LiteLLM
# restarting, a full disk for a minute — into a permanent outage. So this
# unit restarts for ever, and `bin/creche-watchdog.sh` is what says the
# service is not well. `systemctl --user status` still shows NRestarts, so
# a crash loop is as visible as it was.
#
# WHY always. systemd calls SIGHUP, SIGINT, SIGTERM and SIGPIPE clean
# exits, so `Restart=on-failure` does not fire for them: a SIGHUP that
# arrives before a handler is installed leaves the service down. There is
# no clean exit of `caregiver serve` that must stay down — it runs until
# systemd stops it, and systemd does not restart a unit it stopped itself.
#
# WHY the back-off. Restarting for ever is only affordable with one.
# RestartSteps= and RestartMaxDelaySec= are systemd v254 and this host runs
# 255. The delay grows from RestartSec to RestartMaxDelaySec over
# RestartSteps steps, so a transient fault still recovers in five seconds
# and a real crash loop settles at one start every two minutes: 30 an hour
# rather than 720.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/creche
# Every user unit carries both (systemd/AGENTS.md). timers.py writes the
# generated timer units under XDG_CONFIG_HOME.
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
# Decision CH20: vmm.sock is /run/user/<uid>/vmm/vmm.sock, the run root of
# creche-vmm.service. %t is /run/user/<uid> in a user unit. caregiver calls
# the vmm when it deletes a family (decision CH21-10).
Environment=CAREGIVER_VMM_SOCKET=%t/vmm/vmm.sock
# invariant 13: the LiteLLM master key never rides on argv, in a URL or in a
# log line. This file is root-owned and mode 0600; the unit only names it.
EnvironmentFile=/srv/agents/state/creche/caregiver.env
# The site's AGENT_LAN_ADDRESS: where LiteLLM, attendance and the PEP answer.
EnvironmentFile=/etc/creche/site.env
# The component tree contract 06 §1 row 3 fixes, not /opt/creche's
# shared workspace venv. The release executor swaps `<install.to>` and
# restarts this unit, so a unit that ran from anywhere else would relaunch
# the old code after a release the ledger called a success.
# `--pep-url`: contract 05 §3.3. The PEP is the one door to every action, and
# an unwatched PEP can be down while every family's document reads
# `in_sync`. The reconciler probes /healthz for the
# whole fleet and raises `pep_unreachable` after 90 s of silence. The PEP
# binds the LAN address and loopback answers NOTHING there, so this is the
# LAN URL; `bin/rework-cutover.sh` writes the same value into caregiver.env.
# An empty value turns the watch off and every document then says so.
# `--chaperone-config-dir`: the one policy.toml of the chaperone. caregiver
# writes it into /etc/chaperone (root:chaperone 1775, so it replaces its own
# file and not root's install.toml), and runs `chaperone check` on each new
# text before the rename. The binary is the default of `--chaperone-bin`,
# /opt/components/chaperone/bin/chaperone, the released tree.
ExecStart=%h/.local/components/caregiver/bin/caregiver serve \
  /srv/agents/registry \
  --state-root /srv/agents/state/creche \
  --chaperone-config-dir /etc/chaperone \
  --pep-url ${AGENT_PEP_URL} \
  --write
ExecReload=/bin/kill -HUP $MAINPID
# The rework restart policy, argued in [Unit] above.
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=120s
# SIGTERM stops the loop and lets the passes in flight end; none starts
# another one, and `serve` then returns. A pass makes calls of up to 30 s
# each (LiteLLM, `chaperone check`, systemctl), and the vmm drop of a delete
# waits up to 60 s.
#
# So: 360 s here, and loop.py's STOP_GRACE_S is 330 s. The service gives up
# on a pass 30 s before systemd would, which is what makes the journal say
# which family was still in flight rather than leaving a SIGKILL to guess.
# A pass that outruns even that is safe to cut: every step is idempotent
# and repeated by the next pass.
KillSignal=SIGTERM
TimeoutStopSec=360

# A user unit on this host cannot use mount-namespace options
# (apparmor_restrict_unprivileged_userns=1), but seccomp, prctl and rlimit
# options need no namespace (systemd/AGENTS.md).
NoNewPrivileges=yes
SystemCallArchitectures=native
RestrictRealtime=yes
LockPersonality=yes
# 0027, not 0077: the chaperone (user `chaperone`, group `agents`) reads the
# policy.toml this daemon writes. Every file it publishes is chmod'd explicitly anyway;
# this only covers directories made with a bare mkdir.
UMask=0027

[Install]
WantedBy=default.target
