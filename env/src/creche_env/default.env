# The defaults of the product. env/AGENTS.md has the rules of this file.
# A host sets another value in its .env. A value here never changes: a new
# value takes a new key.
# --- The data on the host: one root, and each data path below it ---
AGENT_DATA_ROOT=/srv/agents
AGENT_DATA_STATE_ROOT=${AGENT_DATA_ROOT}/state
AGENT_STATE_ROOT=${AGENT_DATA_STATE_ROOT}/rework
AGENT_SESSIONS_ROOT=${AGENT_DATA_ROOT}/sessions
AGENT_WORK_ROOT=${AGENT_DATA_ROOT}/work
AGENT_CODE_ROOT=${AGENT_DATA_ROOT}/code
AGENT_VAULT_ROOT=${AGENT_DATA_ROOT}/vault
AGENT_REGISTRY_ROOT=${AGENT_DATA_ROOT}/registry
AGENT_INDEX_ROOT=${AGENT_DATA_STATE_ROOT}/index
AGENT_TEST_CORPUS_ROOT=${AGENT_DATA_ROOT}/test
AGENT_EGRESS_ALLOWLIST_FILE=${AGENT_DATA_STATE_ROOT}/egress-allowlist.txt
AGENT_TOKENS_DIR=${AGENT_STATE_ROOT}/tokens
AGENT_SESSIOND_SOCKET=${AGENT_STATE_ROOT}/sock/sessiond.sock
# --- The trees and the files of root ---
AGENT_RELEASE_ROOT=/var/lib/creche-handover
AGENT_REQUESTS_DIR=${AGENT_RELEASE_ROOT}/releases/requests
AGENT_INSTALL_ROOT=/opt/components
AGENT_MCP_ROOT=/opt/mcp
AGENT_MCP_STATE_ROOT=/var/lib/agent-mcp
AGENT_PRODUCT_ROOT=/opt/creche
AGENT_SITE_ROOT=/opt/private-docs
AGENT_WRAPPER_DIR=/usr/local/sbin
AGENT_REFRESH_COMMAND=${AGENT_PRODUCT_ROOT}/bin/sync-code-corpus.sh
AGENT_ROOT_AGE_KEY=/root/.config/sops/age/keys.txt
# --- The accounts and the group ---
AGENT_MCP_USER_PREFIX=mcp-
AGENT_OPERATOR_HOME=${home:AGENT_OPERATOR_USER}
AGENT_OPERATOR_BIN=${AGENT_OPERATOR_HOME}/.local/bin
# --- The code host, the repositories and the build ---
AGENT_CODE_HOST=github.com
AGENT_TOKEN_ISSUER=https://token.actions.githubusercontent.com
AGENT_API_HOST=api.github.com
AGENT_BOT_LOGIN=github-actions[bot]
AGENT_GITHUB_REPO_AGENT_CONTROL=agent-control
AGENT_GITHUB_REPO_AGENT_MCP=agent-mcp
AGENT_GITHUB_REPO_AGENT_REGISTRY=agent-registry
AGENT_REGISTRY_BRANCH=main
AGENT_HOST_PLATFORM=linux/amd64
AGENT_IMAGE_REGISTRY=127.0.0.1:5000
AGENT_PLATFORM_SERVER=github-platform
# --- The programs that root starts, and the search paths ---
AGENT_SOPS_PROGRAM=/usr/local/bin/sops
AGENT_UV_PROGRAM=/usr/local/bin/uv
AGENT_RUNUSER_PROGRAM=/usr/sbin/runuser
AGENT_SYSTEMCTL_PROGRAM=/usr/bin/systemctl
AGENT_INSTALL_PROGRAM=/usr/bin/install
AGENT_GIT_PROGRAM=/usr/bin/git
AGENT_CURL_PROGRAM=/usr/bin/curl
AGENT_CHOWN_PROGRAM=/usr/bin/chown
AGENT_SSH_PROGRAM=/usr/bin/ssh
AGENT_COSIGN_PROGRAM=/usr/local/bin/cosign
AGENT_SYSTEMD_RUN_PROGRAM=/usr/bin/systemd-run
AGENT_ROOT_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
AGENT_CHILD_PATH=/usr/local/bin:/usr/bin:/bin
AGENT_MCP_PROBE_PATH=/usr/bin:/bin
# --- The services of the host, on its LAN address ---
AGENT_PEP_URL=http://${AGENT_LAN_ADDRESS}:8300
AGENT_LITELLM_BASE_URL=http://${AGENT_LAN_ADDRESS}:4000
TEI_URL=http://${AGENT_LAN_ADDRESS}:8085
AGENT_MCP_ALLOWED_HOSTS=
# --- The chaperone ---
# The front door of the Rust chaperone, host:port. The unit passes it to --listen.
CHAPERONE_LISTEN=${AGENT_LAN_ADDRESS}:8300
# --- attendance ---
SESSIOND_SESSIONS_ROOT=${AGENT_SESSIONS_ROOT}
SESSIOND_STATE_ROOT=${AGENT_STATE_ROOT}
SESSIOND_WORK_ROOT=${AGENT_WORK_ROOT}
SESSIOND_SOCKET=${AGENT_SESSIOND_SOCKET}
SESSIOND_BIND_LAN=
SESSIOND_LAN_ADDRESS=${AGENT_LAN_ADDRESS}
SESSIOND_LAN_PORT=8350
# How the supervisor link starts the facade of one sandbox. {env_file} and {sandbox} are filled in.
SESSIOND_FACADE_COMMAND=sbx exec --env-file {env_file} {sandbox} -- creche-facade
# How one ACP door connection reaches the facade of a sandbox. The same two fields.
SESSIOND_ACP_RELAY_COMMAND=sbx exec --env-file {env_file} {sandbox} -- acp-relay
SESSIOND_LOG_DIR=/var/log/sessiond
SESSIOND_LOCK_STALE_S=20.0
SESSIOND_LOCK_POLL_S=1.0
# --- The noticeboard ---
VIEW_BIND=${AGENT_LAN_ADDRESS}
VIEW_PORT=8370
VIEW_STATE_ROOT=${AGENT_STATE_ROOT}
VIEW_REGISTRY_DIR=${AGENT_REGISTRY_ROOT}
VIEW_SESSIOND_SOCKET=${AGENT_SESSIOND_SOCKET}
VIEW_SESSIOND_URL=
VIEW_PAGE_SIZE=50
VIEW_AUDIT_FILE=/var/lib/chaperone/audit.jsonl
VIEW_COOKIE_SECURE=1
VIEW_ACCESS_KEY_FILE=
# --- The door of ACP ---
# The listen address, host:port. The door binds one IP address, never every interface.
DOOR_ACP_BIND=${AGENT_LAN_ADDRESS}:8390
# The file that holds the bearer key of the door. Mode 0600.
DOOR_ACP_KEY_FILE=${AGENT_STATE_ROOT}/door-acp.key
# The file that holds the door-acp token of attendance. Mode 0600.
DOOR_ACP_ATTENDANCE_TOKEN_FILE=${AGENT_TOKENS_DIR}/door-acp.token
# The Unix socket of attendance.
DOOR_ACP_ATTENDANCE_SOCKET=${AGENT_SESSIOND_SOCKET}
# --- The door of the triggers ---
DOOR_TRIGGER_BIND=${AGENT_LAN_ADDRESS}:8360
DOOR_TRIGGER_SESSIOND_SOCKET=${AGENT_SESSIOND_SOCKET}
DOOR_TRIGGER_SESSIOND_URL=
DOOR_TRIGGER_SESSIOND_TOKEN_FILE=${AGENT_TOKENS_DIR}/door-trigger.token
DOOR_TRIGGER_FAMILIES_DIR=${AGENT_STATE_ROOT}/families
DOOR_TRIGGER_REGISTRY_ROOT=${AGENT_REGISTRY_ROOT}
DOOR_TRIGGER_WEBHOOKS_DIR=${AGENT_STATE_ROOT}/triggers/webhooks
DOOR_TRIGGER_REFRESH_S=30.0
DOOR_TRIGGER_STATE_ROOT=${AGENT_STATE_ROOT}
DOOR_TRIGGER_PEP_URL=${AGENT_PEP_URL}
# The audit file of the chaperone. The quiet check reads it as a member of the group chaperone.
DOOR_TRIGGER_AUDIT_FILE=/var/lib/chaperone/audit.jsonl
# --- The caregiver ---
MANAGERD_STATE_ROOT=${AGENT_STATE_ROOT}
# --- The scripts of bin/ ---
CODE_CORPUS_ROOT=${AGENT_CODE_ROOT}
CODE_REPO_LIST=${AGENT_DATA_STATE_ROOT}/code-repos.txt
