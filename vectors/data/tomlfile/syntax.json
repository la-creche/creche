  {"id":"integers-of-each-base","input":{"text":"a = 0xDEAD_beef\nb = 0o17\nc = 0b101\n"},"result":"accepted","value":{"a":3735928559,"b":15,"c":5}},
  {"id":"integer-largest","input":{"text":"a = 9223372036854775807\n"},"result":"accepted","value":{"a":9223372036854775807}},
