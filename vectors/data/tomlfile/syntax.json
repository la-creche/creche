  {"id":"basic-string","input":{"text":"a = \"one \\\"two\\\" \\\\ \\t \\u00e9 \\U0001F600\"\n"},"result":"accepted","value":{"a":"one \"two\" \\ \t \u00e9 \ud83d\ude00"}},
  {"id":"literal-string","input":{"text":"a = 'one \\n \"two\"'\n"},"result":"accepted","value":{"a":"one \\n \"two\""}},
  {"id":"multi-line-basic-string","input":{"text":"a = \"\"\"\nfirst\nsecond \\\n     third \"\" end\"\"\"\n"},"result":"accepted","value":{"a":"first\nsecond third \"\" end"}},
