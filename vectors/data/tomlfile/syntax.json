  {"id":"floats","input":{"text":"a = 1.5\nb = -2e3\nc = 6.02E+23\nd = 1_0.2_5\n"},"result":"accepted","value":{"a":1.5,"b":-2000.0,"c":6.02e+23,"d":10.25}},
  {"id":"float-inf","input":{"text":"a = inf\nb = +inf\nc = -inf\n"},"result":"accepted","value":{"a":{"$float":"Infinity"},"b":{"$float":"Infinity"},"c":{"$float":"-Infinity"}}},
