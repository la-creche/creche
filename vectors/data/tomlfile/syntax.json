  {"id":"list-of-tables","input":{"text":"[[rows]]\nname = \"a\"\n\n[[rows]]\nname = \"b\"\n\n[[rows.fences]]\ntool = \"t\"\n"},"result":"accepted","value":{"rows":[{"name":"a"},{"fences":[{"tool":"t"}],"name":"b"}]}},
  {"id":"inline-table","input":{"text":"a = {b = 1, c = {d = 2}, e = []}\n"},"result":"accepted","value":{"a":{"b":1,"c":{"d":2},"e":[]}}},
  {"id":"list-of-each-kind","input":{"text":"a = [1, \"two\", 3.0, true, [4], {five = 5}]\n"},"result":"accepted","value":{"a":[1,"two",3.0,true,[4],{"five":5}]}},
  {"id":"list-on-more-lines","input":{"text":"a = [\n  1, # a comment\n  2,\n]\n"},"result":"accepted","value":{"a":[1,2]}},
