#!/usr/bin/env bash
# CI — the `playpen-image` job runs it on each built flavor and each built
# service image:
#   playpen/bin/playpen-env-check <image> [flavor|service]
#
# It holds `/etc/creche/env` of the image equal to the env of the image's
# config, inherited names included (CH7-7, CH49). The config gives one
# `NAME=value` line per variable. The file must hold the same lines, sorted
# by name in byte order, with each PATH folder only once
# (`creche-env-write`).
#
# For the kind `flavor` (the default), it then places each name of the
# file in one list of the agent (CH49 rule 1). Node in the image runs `placeEnvFile` of the agent module that
# the image ships (`agent/src/tool-env.ts`), so the lists are the ones the
# flavor runs, and no second copy exists. The file's names are the built
# env, the parent image's names such as NODE_VERSION too.
#
# The kind `service` is a service image of catalog.SERVICE_IMAGES. It runs
# no agent and ships no node, so it gets the env check only.
# CONTRACT-QUESTION: CH49 rule 1 names the env of an agent image and is
# silent on a service image. The reading here: the equal check of CH7-7
# still holds, and the agent list check does not apply. A service image
# that runs an agent tool later needs a list of its own.
#
# Exit 0 when the two are equal and each name sits in a list. Exit 1, with
# a diff or the unplaced names, when one fails or when docker or node
# cannot answer.
set -euo pipefail

die() { printf 'playpen-env-check: %s\n' "$*" >&2; exit 1; }

usage="usage: playpen-env-check <image> [flavor|service]"
[[ "$#" -eq 1 || "$#" -eq 2 ]] || die "$usage"
image="$1"
kind="${2:-flavor}"
[[ "$kind" == flavor || "$kind" == service ]] || die "$usage"

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT

docker image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$image" \
  > "$work/config" || die "docker has no config for $image"
docker run --rm --network none --entrypoint /bin/cat "$image" /etc/creche/env \
  > "$work/file" || die "$image has no /etc/creche/env"

name='^[A-Za-z_][A-Za-z0-9_]*='
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  [[ "$line" =~ $name ]] || die "the config of $image holds a line that is no NAME=value line: $line"
  if [[ "$line" == PATH=* ]]; then
    line="PATH=$(printf '%s\n' "${line#PATH=}" | tr ':' '\n' | awk '!seen[$0]++' | paste -sd: -)"
  fi
  printf '%s\n' "$line"
done < "$work/config" | LC_ALL=C sort -t= -k1,1 > "$work/expected"

if ! diff -u --label "config of $image" --label "/etc/creche/env" "$work/expected" "$work/file"; then
  die "/etc/creche/env of $image is not the env of its config. List each new name in the RUN of creche-env-write in playpen/Dockerfile."
fi

if [[ "$kind" == service ]]; then
  printf 'playpen-env-check: %s: /etc/creche/env equals the config env (%s names, a service image)\n' \
    "$image" "$(wc -l < "$work/file" | tr -d ' ')"
  exit 0
fi

# Node runs in the facade's deploy tree, where the bare name
# `agent/tool-env` resolves. `placeEnvFile` prints the count of lines it
# read, then each unplaced name on one line. A report with a wrong count,
# or no report, fails, so a program that prints nothing never passes.
place='import { readFileSync } from "node:fs"; import { placeEnvFile } from "agent/tool-env"; process.stdout.write(placeEnvFile(readFileSync("/etc/creche/env", "utf8")));'
report="$(docker run --rm --network none --workdir /opt/creche-facade --entrypoint node "$image" \
  --input-type=module --eval "$place")" || die "node in $image cannot run placeEnvFile of the agent"
count="$(wc -l < "$work/file" | tr -d ' ')"
read_count="$(head -n 1 <<< "$report")"
[[ "$read_count" == "$count" ]] \
  || die "placeEnvFile in $image read ${read_count:-no} lines of /etc/creche/env, not $count"
unplaced="$(tail -n +2 <<< "$report")"
if [[ -n "$unplaced" ]]; then
  die "$image: no agent list holds $(paste -sd' ' - <<< "$unplaced"). Put each name in one list of agent/src/tool-env.ts (CH49 rule 1)."
fi
printf 'playpen-env-check: %s: /etc/creche/env equals the config env, and each name sits in an agent list (%s names)\n' \
  "$image" "$count"
