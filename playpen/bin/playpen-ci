#!/usr/bin/env bash
# CI — the `playpen-image` job of gate.yml and release.yml runs it from the
# repository root:
#   playpen/bin/playpen-ci
#
# It builds each flavor and checks what the build alone cannot check:
#
#   1. `docker build` of each target, tagged `playpen-ci/<target>`. The
#      python flavor builds on the base flavor, so the second build reuses
#      the first.
#   2. `playpen-env-check` on each image: `/etc/creche/env` equals the
#      image config env (CH7-7, CH49).
#   3. `playpen-rootfs` of each target: the tar export that a root disk
#      is made from builds, holds `/etc/creche/env` and holds no
#      `.dockerenv` (CH7-2, fact 59). The export reuses the build cache.
#   4. `playpen-disk` of each tar, two times: both runs give the same
#      disk digest (CH7-2). The script removes each tar and disk after the
#      check.
#   5. `playpen-kernel`: the guest kernel fetches, has its pinned SHA-256
#      and compresses (CH7-3).
#
# The job keeps its steps here, so a new check of the image changes this
# file and not the two workflow files.
set -euo pipefail

say() { printf '%s\n' "$*"; }
die() { printf 'playpen-ci: %s\n' "$*" >&2; exit 1; }

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
PLATFORM=linux/amd64

work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT

# The flavors of playpen-build, in the same order, then the flavors that
# ship as a root disk only (playpen/AGENTS.md rule 6).
FLAVORS="base:agent-sandbox python:agent-sandbox-python coding:agent-sandbox-coding"

for pair in $FLAVORS; do
  flavor="${pair%%:*}"
  target="${pair#*:}"
  image="playpen-ci/$target"
  say "building $target"
  docker build --platform "$PLATFORM" -f "$ROOT/playpen/Dockerfile" --target "$target" \
    -t "$image" "$ROOT" || die "the $target build failed"
  "$ROOT/playpen/bin/playpen-env-check" "$image"
  "$ROOT/playpen/bin/playpen-rootfs" "$target" "$work/$target.tar"
  mkdir "$work/one" "$work/two"
  first="$("$ROOT/playpen/bin/playpen-disk" "$work/$target.tar" "$work/one" "$flavor")"
  second="$("$ROOT/playpen/bin/playpen-disk" "$work/$target.tar" "$work/two" "$flavor")"
  [[ "$first" == "$second" ]] || die "two disks of one $target tar differ: $first, $second"
  say "$first"
  rm -rf -- "$work/$target.tar" "$work/one" "$work/two"
done

mkdir "$work/kernel"
"$ROOT/playpen/bin/playpen-kernel" "$work/kernel"
