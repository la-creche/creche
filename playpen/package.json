{
  "name": "playpen",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "playpen: the process inside a family sandbox that speaks contract 03 over one sbx exec and multiplexes one pi rpc process per session.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm build:playpen && pnpm build:launch && pnpm build:bridge",
    "build:playpen": "node build.mjs src/index.ts dist/playpen.js",
    "build:launch": "node build.mjs src/launch-main.ts dist/agent-pi-launch.js",
    "build:bridge": "esbuild bridge/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/pep-bridge.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "^24",
    "esbuild": "^0.24",
    "typescript": "^5.6",
    "vitest": "^3"
  },
  "packageManager": "pnpm@11.20.0"
}
