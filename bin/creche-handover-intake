#!/usr/bin/env bash
# ROOT — run by systemd/creche-handover-intake.service; by hand:
#   sudo /usr/local/sbin/creche-handover-intake
#
# The secret intake's entry point (docs/rework/stage7-releases.md §4.3).
#
# Installed to /usr/local/sbin BY HAND, never by a release. Contract 06 §1.1:
# "the thing that deploys code is not deployed by code", and this one holds
# the path a pasted secret travels. A release may refresh this file in place
# where one already exists. A release may never install one.
#
# All it does: decrypt the site's sops file with root's age key — the one
# place RELEASE_APPROVAL_URL and RELEASE_APPROVAL_TOKEN live — and exec the
# intake under it. The bearer reaches the intake in its environment, never in
# argv and never in a URL (invariant 13), and the intake clears every other
# name out of that environment before it accepts a connection.
#
# It differs from bin/creche-handover in one way, and the reason is the
# whole of §4.3. The release wrapper has a fallback: without its token the
# executor still runs, because creche-handover.path is a PathExistsGlob
# and one undrained request loops the unit into systemd's start limit. This
# one has NO fallback. Nothing loops if the intake does not start, and an
# intake that cannot tell the operator about a token would mint capabilities nobody
# is ever told about. Refusing to start is the fail-closed end.
set -euo pipefail
[[ "$(id -u)" == "0" ]] || { echo "creche-handover-intake: root only" >&2; exit 1; }

SOPS=/usr/local/bin/sops
# The site's own sops file, the one the release wrapper reads
# (bin/creche-handover says why the path is resolved first).
SITE_SECRETS=/etc/agent-control/secrets.enc.env
SECRETS="$(readlink -f "$SITE_SECRETS" 2>/dev/null)" || SECRETS="$SITE_SECRETS"
INTAKE=/opt/components/handover/bin/handover-intake
export SOPS_AGE_KEY_FILE=/root/.config/sops/age/keys.txt
# Every path below is absolute, so the directory decides nothing.
cd /

# Root either EXECUTES or DECRYPTS three paths here, so a path operator-side
# code can write is a path that decides what root runs. sops was <operator>:kvm
# 0775 on the host, measured 2026-09-16.
require_root_owned() {
  local path="$1" info
  info="$(stat -c '%U:%G %a' "$path" 2>/dev/null)" || return 1
  [[ "${info%% *}" == "root:root" ]] || return 1
  # No write bit for group or other. The three paths have three different
  # modes, so the mode itself is not what is asserted.
  (( (8#"${info##* }" & 8#22) == 0 )) || return 1
  return 0
}

# require_root_chain PATH: every directory above PATH, up to /, is root's
# and unwritable by others. A directory somebody else can write is a file
# they can swap after `require_root_owned` looked at it.
require_root_chain() {
  local dir
  dir="$(dirname -- "$1")"
  while :; do
    require_root_owned "$dir" || return 1
    [[ "$dir" == "/" ]] && return 0
    dir="$(dirname -- "$dir")"
  done
}

# Its contents become root's whole environment, and `sops exec-env` runs its
# command under `sh -c`. A writer of this file picks names such as LD_PRELOAD,
# so ownership is the control here, not the encryption: the recipient is
# readable out of the file's own header.
# Each path's directories as well: whoever can write one of them decides
# what the path names after the guard looked.
for path in "$INTAKE" "$SOPS" "$SECRETS"; do
  if ! require_root_owned "$path" || ! require_root_chain "$path"; then
    echo "creche-handover-intake: $path or a directory above it is not root:root and unwritable by others; refusing to run" >&2
    exit 1
  fi
done

if ! require_root_chain "$SITE_SECRETS"; then
  echo "creche-handover-intake: a directory above $SITE_SECRETS is not root:root and unwritable by others; refusing to run" >&2
  exit 1
fi

if ! "$SOPS" exec-env "$SECRETS" true; then
  echo "creche-handover-intake: cannot decrypt $SECRETS; not starting without the push path" >&2
  exit 1
fi

exec "$SOPS" exec-env "$SECRETS" "$INTAKE"
