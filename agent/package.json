{
  "name": "agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "agent: the generic Flue agent of a family sandbox. A library the facade imports.",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./strict-json": {
      "types": "./dist/strict-json.d.ts",
      "default": "./dist/strict-json.js"
    },
    "./tool-env": {
      "types": "./dist/tool-env.d.ts",
      "default": "./dist/tool-env.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "default": "./dist/wire.js"
    },
    "./wire-read": {
      "types": "./dist/wire-read.d.ts",
      "default": "./dist/wire-read.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@flue/runtime": "2.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "typebox": "1.3.27",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.6",
    "vitest": "^3"
  },
  "packageManager": "pnpm@11.20.0"
}
