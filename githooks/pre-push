#!/usr/bin/env bash
# Nothing leaves this machine failing lint, formatting or types. The hook
# runs no test. CI runs every test on Linux and is the merge gate
# (.github/workflows/gate.yml).
#
# See githooks/pre-commit for why: a hook inherits GIT_DIR (worktrees: also
# GIT_WORK_TREE) from the git command that invoked it, and a `git` child of
# the gate would inherit the same variables, pointed at the DEVELOPER's repo.
# Unset them before anything else runs.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

# Resolve the repo root from the worktree git is actually operating on —
# see githooks/pre-commit for why $0-based resolution would run every
# worktree's quality gate against the primary checkout instead.
ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/bin/quality-gate.sh"
